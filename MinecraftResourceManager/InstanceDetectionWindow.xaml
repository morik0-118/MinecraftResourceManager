<Window x:Class="MinecraftResourceManager.InstanceDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インスタンス検出"
        Width="850"
        Height="500"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- ハイライト -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>

            <Style.Triggers>

                <!-- 共有設定が変更され、まだ適用されていない -->
                <!-- 「追加」がONの行を薄くハイライト -->
                <DataTrigger Binding="{Binding IsSelected}"
                     Value="True">

                    <Setter Property="Background"
                    Value="#FFF4CC"/>

                </DataTrigger>

            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="検出されたMinecraftインスタンス"
                       FontSize="22"
                       FontWeight="Bold"/>

            <TextBlock Text="追加するインスタンスを選択してください。"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Candidates}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">

            <DataGrid.Resources>

                <!-- 選択中の背景色 -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="#80A0A0A0"/>

                <!-- 選択中の文字色 -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="Black"/>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="追加"
                                        Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="インスタンス名"
                                    Binding="{Binding Name}"
                                    Width="180"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="場所"
                                    Binding="{Binding Path}"
                                    Width="*"
                                    IsReadOnly="True"/>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="選択を追加"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    FontWeight="Bold"
                    Click="AddSelected_Click"/>

            <Button Content="キャンセル"
                    Width="100"
                    Height="30"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>
</Window>