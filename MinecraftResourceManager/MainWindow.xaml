<Window x:Class="MinecraftResourceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Resource Manager"
        Height="700"
        Width="1000"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 全体の基本フォント -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 通常ボタン -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- 共有チェックボックス -->
        <Style x:Key="ShareCheckBoxStyle"
               TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <!-- リソパ・シェーダーの状態表示 -->
        <Style x:Key="PackStatusStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Style.Triggers>

                <!-- 共有中 -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Value="共有中">
                    <Setter Property="Foreground" Value="ForestGreen"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>

                <!-- 未共有 -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Value="未共有">
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>

                <!-- なし -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Value="なし">
                    <Setter Property="Foreground" Value="DarkOrange"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>

                <!-- エラー -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Value="エラー">
                    <Setter Property="Foreground" Value="Crimson"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>
        
        <!-- ハイライト -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>

            <Style.Triggers>

                <!-- 共有設定が変更され、まだ適用されていない -->
                <DataTrigger Binding="{Binding IsSharingChanged}"
                     Value="True">

                    <Setter Property="Background"
                    Value="#FFF4CC"/>

                </DataTrigger>

            </Style.Triggers>
        </Style>


        <!-- インスタンス全体の状態 -->
        <Style x:Key="InstanceStatusStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Style.Triggers>

                <!-- 適用済み -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Value="適用済み">
                    <Setter Property="Foreground" Value="SteelBlue"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>

                <!-- エラー -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Value="エラー">
                    <Setter Property="Foreground" Value="Crimson"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- タイトル -->
        <!-- ========================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">

            <TextBlock Text="Minecraft Resource Manager"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Minecraftインスタンス間でリソースパック・シェーダーパックを共有します。"
                       FontSize="14"
                       Foreground="#555555"
                       Margin="0,6,0,0"/>
        </StackPanel>


        <!-- ========================= -->
        <!-- 共有フォルダ -->
        <!-- ========================= -->

        <GroupBox Grid.Row="1"
                  Header="共有フォルダ"
                  Padding="12"
                  Margin="0,0,0,18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>


                <!-- Resource Packs -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Resource Packs"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         x:Name="ResourcePackPath"
                         Height="30"
                         Margin="5,0,8,5"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="参照..."
                        Height="30"
                        Margin="0,0,0,5"
                        Click="SelectResourcePackFolder_Click"/>


                <!-- Shader Packs -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Shader Packs"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         x:Name="ShaderPackPath"
                         Height="30"
                         Margin="5,5,8,0"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="参照..."
                        Height="30"
                        Margin="0,5,0,0"
                        Click="SelectShaderPackFolder_Click"/>

            </Grid>

        </GroupBox>


        <!-- ========================= -->
        <!-- Minecraft インスタンス -->
        <!-- ========================= -->

        <GroupBox Grid.Row="2"
          Header="Minecraft インスタンス"
          Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- インスタンス一覧 -->

                <DataGrid Grid.Row="0"
                          x:Name="InstanceList"
                          ItemsSource="{Binding Instances}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Margin="0"
                          PreviewMouseLeftButtonDown="InstanceList_PreviewMouseLeftButtonDown">

                    <DataGrid.Resources>

                        <!-- 選択中の背景色 -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="#80A0A0A0"/>

                        <!-- 選択中の文字色 -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="Black"/>

                    </DataGrid.Resources>

                    <DataGrid.Columns>


                        <!-- インスタンス名 -->

                        <DataGridTextColumn Header="インスタンス名"
                                    Binding="{Binding Name}"
                                    Width="130"
                                    IsReadOnly="True"/>


                        <!-- 場所 -->

                        <DataGridTextColumn Header="場所"
                                    Binding="{Binding Path}"
                                    Width="*"
                                    IsReadOnly="True"/>


                        <!-- リソパ共有 -->

                        <DataGridTemplateColumn Header="リソースパック"
                                        Width="80">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <CheckBox
                                IsChecked="{Binding ShareResourcePacks,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- シェーダー共有 -->

                        <DataGridTemplateColumn Header="シェーダーパック"
                                        Width="80">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <CheckBox
                                IsChecked="{Binding ShareShaderPacks,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- リソパ状態 -->

                        <DataGridTemplateColumn Header="リソース状態"
                                        Width="80">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                Text="{Binding ResourcePackStatus}"
                                Style="{StaticResource PackStatusStyle}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- シェーダー状態 -->

                        <DataGridTemplateColumn Header="シェーダー状態"
                                        Width="80">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                Text="{Binding ShaderPackStatus}"
                                Style="{StaticResource PackStatusStyle}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- 状態 -->

                        <DataGridTemplateColumn Header="状態"
                                        Width="80">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                Text="{Binding Status}"
                                Style="{StaticResource InstanceStatusStyle}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                </DataGrid>


                <!-- 操作ボタン -->

                <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">

                    <Button Content="インスタンス検出"
                    Width="140"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="DetectInstances_Click"/>

                    <Button Content="インスタンス追加"
                    Width="140"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="AddInstance_Click"/>

                    <Button Content="選択を削除"
                    Width="140"
                    Height="35"
                    Click="RemoveInstance_Click"/>

                </StackPanel>

            </Grid>

        </GroupBox>


        <!-- ========================= -->
        <!-- 下部ステータス -->
        <!-- ========================= -->

        <Grid Grid.Row="3"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- ステータス -->

            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       Text="準備完了"
                       FontSize="13"
                       Foreground="#444444"
                       VerticalAlignment="Center"/>


            <!-- 適用ボタン -->

            <Button Grid.Column="1"
                    Content="共有を適用"
                    Width="160"
                    Height="46"
                    FontSize="15"
                    FontWeight="Bold"
                    Padding="15,5"
                    Click="CreateLinks_Click"/>

        </Grid>

    </Grid>

</Window>